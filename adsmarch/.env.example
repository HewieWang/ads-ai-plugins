# ───────────────────────── Adsmarch runtime ─────────────────────────

# mock = 本地模拟（默认，零花费，可用于演示） | live = 真实调用广告平台
ADS_MODE=mock

# required = 高风险操作需审批（默认） | strict = 所有写操作都审批 | auto = 全部直接执行并写审计
ADS_APPROVAL_MODE=required

# 管理台与 OAuth 回调
ADS_HTTP_PORT=8787
ADS_PUBLIC_BASE_URL=http://localhost:8787

# 可选：设置后管理台 API 需要 x-admin-token 或 ?token=
ADS_ADMIN_TOKEN=

# 存储
ADS_DATA_DIR=./data
ADS_DB_PATH=./data/adsmarch.db
# 32 字节密钥（base64 或 64 位 hex）。生成：openssl rand -base64 32
# 不填会首次启动自动生成到 data/.adsmarch.key；生产环境务必显式配置。
ADS_ENCRYPTION_KEY=

# 单账户单日预算安全上限（账户币种）
ADS_MAX_DAILY_BUDGET=2000
# 指标缓存秒数
ADS_INSIGHTS_CACHE_TTL_SECONDS=600

# ───────────────────────── Google Ads ─────────────────────────
# Google Cloud OAuth 客户端（Web application）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Ads API Center 申请的开发者令牌
GOOGLE_DEVELOPER_TOKEN=
# MCC 管理账户 ID（不带连字符），访问子账户时必填
GOOGLE_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21

# ───────────────────────── Meta ─────────────────────────
# Meta 开发者应用（Business 类型）
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v23.0
# 可选：默认 Facebook 主页 ID，用于链接广告创意
META_PAGE_ID=

# ───────────────────────── TikTok ─────────────────────────
# TikTok for Business 开发者应用
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_API_VERSION=v1.3

# 可选：出网代理（沙箱/内网环境）
HTTPS_PROXY=
